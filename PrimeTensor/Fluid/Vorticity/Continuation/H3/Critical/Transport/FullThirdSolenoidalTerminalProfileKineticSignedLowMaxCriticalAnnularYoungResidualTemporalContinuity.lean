/-!
# Genuine nonlinear Fourier Young residual: quantitative H³ variation and temporal continuity

The actual Young-gap integrand is generated by the true Leray forcing and
raw spectral Laplacian, not by a formal substitute:

    G_j(U) = N_j(U,U) - 2 L_j(U),
    N_j(U,U) = h3RawFinLerayOuterProductDivergenceFourierL2 U U j,
    L_j(U) = h3SpectralScalarLaplacianRawFourierL2 (U j).

The existing bilinear Fourier estimate proves an explicit locally Lipschitz
bound for G_j on weighted H³ spectral states. Consequently the exact L²
annular cutoff of G_j has a strongly continuous physical-time trajectory,
and its *unweighted* squared Fourier mass is continuous.

The previously defined annular Young-width cost additionally multiplies the
residual by q(ξ)^3. That frequency multiplier is bounded on a fixed finite
annulus, but its L² multiplier representation and its exact weighted integral
identity are not proved by this file. In particular this file does NOT claim
continuity of the full weighted Young-width functional or H³ continuation.
-/

namespace PrimeTensor.FirstMonomialTriad

open PrimeTensor.Bridge.Euclidean MeasureTheory Set Filter Topology
open scoped BigOperators Interval InnerProductSpace RealInnerProductSpace

noncomputable section
set_option maxHeartbeats 2400000
set_option maxRecDepth 4096

noncomputable local instance axisFintypeAnnularYoungResidualContinuity244
    (d : Depth) : Fintype (PrimeTensor.Axis d) :=
  Fintype.ofFinite (PrimeTensor.Axis d)

noncomputable local instance point3MeasureSpaceAnnularYoungResidualContinuity244 :
    MeasureSpace Point3 :=
  @MeasureTheory.MeasureSpace.pi
    (PrimeTensor.Axis Depth.three)
    (Fintype.ofFinite (PrimeTensor.Axis Depth.three))
    (fun _ : PrimeTensor.Axis Depth.three => ℝ)
    (fun _ : PrimeTensor.Axis Depth.three => Real.measureSpace)

/-- Actual physical anti-heat Young residual in genuine Fourier L².
The Laplacian carries its correct negative sign, so N - 2 L has the
pointwise representative N + 2 q z used in the annular Young gap. -/
noncomputable def thirdFullPhysicalAnnularYoungResidualFourierL2244
    (U : H3SpectralVelocityState) (j : Fin 3) : H3FourierComplexL2 :=
  h3RawFinLerayOuterProductDivergenceFourierL2 U U j -
    (2 : ℂ) • h3SpectralScalarLaplacianRawFourierL2 (U j)

/-- Explicit quadratic Leray plus linear Laplacian difference bound.
No viscosity norm or extra PDE regularity is assumed. -/
theorem thirdFullPhysical_annularYoungResidualFourier_sub_norm_le244
    (U V : H3SpectralVelocityState) (j : Fin 3) :
    ‖thirdFullPhysicalAnnularYoungResidualFourierL2244 U j -
      thirdFullPhysicalAnnularYoungResidualFourierL2244 V j‖ ≤
      ((576 * Real.pi * h3SobolevDeweightingConstant) *
          (‖U‖ + ‖V‖) + 2) * ‖U - V‖ := by
  let N : H3SpectralVelocityState → H3FourierComplexL2 :=
    fun Z => h3RawFinLerayOuterProductDivergenceFourierL2 Z Z j
  let L : H3SpectralVelocityState → H3FourierComplexL2 :=
    fun Z => h3SpectralScalarLaplacianRawFourierL2 (Z j)
  have hN : ‖N U - N V‖ ≤
      (576 * Real.pi * h3SobolevDeweightingConstant) *
        (‖U‖ + ‖V‖) * ‖U - V‖ :=
    h3Path_rawLerayFourier_diagonal_sub_norm_le244 U V j
  have hCoord : ‖U j - V j‖ ≤ ‖U - V‖ := by
    simpa only [Pi.sub_apply] using (norm_le_pi_norm (U - V) j)
  have hL : ‖L U - L V‖ ≤ ‖U - V‖ :=
    (norm_h3SpectralScalarLaplacianRawFourierL2_sub_le (U j) (V j)).trans hCoord
  have hEq :
      thirdFullPhysicalAnnularYoungResidualFourierL2244 U j -
        thirdFullPhysicalAnnularYoungResidualFourierL2244 V j =
      (N U - N V) - (2 : ℂ) • (L U - L V) := by
    dsimp only [thirdFullPhysicalAnnularYoungResidualFourierL2244, N, L]
    rw [smul_sub]
    abel
  rw [hEq]
  calc
    ‖(N U - N V) - (2 : ℂ) • (L U - L V)‖ ≤
        ‖N U - N V‖ + ‖(2 : ℂ) • (L U - L V)‖ := norm_sub_le _ _
    _ = ‖N U - N V‖ + 2 * ‖L U - L V‖ := by
      simp only [norm_smul]
      norm_num
    _ ≤ (576 * Real.pi * h3SobolevDeweightingConstant) *
          (‖U‖ + ‖V‖) * ‖U - V‖ + 2 * ‖U - V‖ :=
      add_le_add hN (mul_le_mul_of_nonneg_left hL (by norm_num))
    _ = ((576 * Real.pi * h3SobolevDeweightingConstant) *
          (‖U‖ + ‖V‖) + 2) * ‖U - V‖ := by ring

/-- Strong Fourier L² continuity of the actual, nonlinear Young residual
as a map on all weighted H³ states. Separate the continuous forcing on the
product Hilbert space from its diagonal pullback to avoid unfolding the
large raw Leray expression while elaborating `Continuous.comp`. -/
theorem thirdFullPhysical_annularYoungResidualFourier_continuous244
    (j : Fin 3) :
    Continuous (fun U : H3SpectralVelocityState =>
      thirdFullPhysicalAnnularYoungResidualFourierL2244 U j) := by
  let D : H3SpectralVelocityState →
      H3SpectralVelocityState × H3SpectralVelocityState :=
    fun U => (U, U)
  have hD : Continuous D := by
    exact Continuous.prodMk continuous_id continuous_id
  let N : H3SpectralVelocityState × H3SpectralVelocityState →
      H3FourierComplexL2 :=
    fun p => h3RawFinLerayOuterProductDivergenceFourierL2 p.1 p.2 j
  have hN : Continuous N := by
    dsimp only [N]
    exact continuous_h3RawFinLerayOuterProductDivergenceFourierL2 j
  have hDiagonal : Continuous (fun U : H3SpectralVelocityState =>
      h3RawFinLerayOuterProductDivergenceFourierL2 U U j) := by
    have hComp := hN.comp hD
    change Continuous (fun U : H3SpectralVelocityState =>
      h3RawFinLerayOuterProductDivergenceFourierL2 U U j) at hComp
    exact hComp
  have hL : Continuous (fun U : H3SpectralVelocityState =>
      h3SpectralScalarLaplacianRawFourierL2 (U j)) := by
    exact continuous_h3SpectralScalarLaplacianRawFourierL2.comp
      (continuous_apply j)
  change Continuous (fun U : H3SpectralVelocityState =>
    h3RawFinLerayOuterProductDivergenceFourierL2 U U j -
      (2 : ℂ) • h3SpectralScalarLaplacianRawFourierL2 (U j))
  -- Function addition and pointwise Fourier L² addition are
  -- definitionally equal, but `simp` does not eta-expand a bare function.
  -- Change the continuity certificate to pointwise addition first.
  have hScaled : Continuous (fun U : H3SpectralVelocityState =>
      (2 : ℂ) • h3SpectralScalarLaplacianRawFourierL2 (U j)) := by
    have hAdd := hL.add hL
    change Continuous (fun U : H3SpectralVelocityState =>
      h3SpectralScalarLaplacianRawFourierL2 (U j) +
        h3SpectralScalarLaplacianRawFourierL2 (U j)) at hAdd
    simpa only [two_smul ℂ] using hAdd
  exact hDiagonal.sub hScaled

/-- The fixed-radius actual annular Fourier Young residual is obtained by
subtracting two genuine sharp L² lowpass projections. No representative
value at any single frequency is used. -/
noncomputable def thirdFullPhysicalAnnularYoungResidualBandFourierL2244
    (rho sigma : ℝ) (U : H3SpectralVelocityState) (j : Fin 3) :
    H3FourierComplexL2 :=
  h3CriticalFourierSharpLowCutoffCLM sigma
      (thirdFullPhysicalAnnularYoungResidualFourierL2244 U j) -
    h3CriticalFourierSharpLowCutoffCLM rho
      (thirdFullPhysicalAnnularYoungResidualFourierL2244 U j)

/-- Fixed annular Fourier restriction of the nonlinear residual is strongly
continuous in the actual weighted H³ spectral state. -/
theorem thirdFullPhysical_annularYoungResidualBand_continuous244
    (rho sigma : ℝ) (j : Fin 3) :
    Continuous (fun U : H3SpectralVelocityState =>
      thirdFullPhysicalAnnularYoungResidualBandFourierL2244 rho sigma U j) := by
  have hR := thirdFullPhysical_annularYoungResidualFourier_continuous244 j
  exact ((h3CriticalFourierSharpLowCutoffCLM sigma).continuous.comp hR).sub
    ((h3CriticalFourierSharpLowCutoffCLM rho).continuous.comp hR)

/-- The genuine preterminal spectral path makes the fixed-annular nonlinear
Young residual strongly continuous in Fourier L², with no independent
nonlinear continuity hypothesis. -/
theorem thirdFullPhysical_actualAnnularYoungResidualBand_continuousAt244
    {u : SpaceTimeVectorField ℝ ℝ MulReal Depth.three}
    {T : ℝ} (hH3 : LoggedPreterminalH3PathAdmissible u T)
    (rho sigma t : ℝ) (ht : t ∈ Set.Ioo (0 : ℝ) T) (j : Fin 3) :
    ContinuousAt (fun s : ℝ =>
      thirdFullPhysicalAnnularYoungResidualBandFourierL2244 rho sigma
        (h3AuditActualSpectralVelocityTotal hH3 s) j) t := by
  exact (thirdFullPhysical_annularYoungResidualBand_continuous244
    rho sigma j).continuousAt.comp
      (h3Audit_initialActualSpectralVelocity_continuousAt hH3 ht)

/-- In particular, the ACTUAL nonlinear annular residual's unweighted
Fourier L² square mass is continuous at every strict physical time. -/
theorem thirdFullPhysical_actualAnnularYoungResidualBandSquare_continuousAt244
    {u : SpaceTimeVectorField ℝ ℝ MulReal Depth.three}
    {T : ℝ} (hH3 : LoggedPreterminalH3PathAdmissible u T)
    (rho sigma t : ℝ) (ht : t ∈ Set.Ioo (0 : ℝ) T) (j : Fin 3) :
    ContinuousAt (fun s : ℝ =>
      ‖thirdFullPhysicalAnnularYoungResidualBandFourierL2244 rho sigma
        (h3AuditActualSpectralVelocityTotal hH3 s) j‖ ^ 2) t := by
  exact (thirdFullPhysical_actualAnnularYoungResidualBand_continuousAt244
    hH3 rho sigma t ht j).norm.pow 2

/-- The packaged nonlinear Fourier L² residual is exactly the integrand
`N(U,U) + 2 q z` of the genuine annular Young-gap, almost everywhere. -/
theorem thirdFullPhysical_annularYoungResidualFourier_ae244
    (U : H3SpectralVelocityState) (j : Fin 3) :
    ((thirdFullPhysicalAnnularYoungResidualFourierL2244 U j :
      H3FourierComplexL2) : H3FourierPoint3 → ℂ)
      =ᵐ[(volume : Measure H3FourierPoint3)]
    (fun ξ => h3RawFinLerayOuterProductDivergence U U j ξ +
      2 * ((h3FourierGradientSquare ξ : ℂ) *
        h3SpectralScalarRawFourierL2 (U j) ξ)) := by
  let L : H3FourierComplexL2 :=
    h3SpectralScalarLaplacianRawFourierL2 (U j)
  let N : H3FourierComplexL2 :=
    h3RawFinLerayOuterProductDivergenceFourierL2 U U j
  have hLap : (L : H3FourierPoint3 → ℂ)
      =ᵐ[(volume : Measure H3FourierPoint3)]
      (fun ξ => -(h3FourierGradientSquare ξ : ℂ) *
        h3SpectralScalarRawFourierL2 (U j) ξ) :=
    h3SpectralScalarLaplacianRawFourierL2_ae_eq_gradientSquare_mul_raw (U j)
  have hN : (N : H3FourierPoint3 → ℂ)
      =ᵐ[(volume : Measure H3FourierPoint3)]
      (fun ξ => h3RawFinLerayOuterProductDivergence U U j ξ) := by
    dsimp only [N]
    unfold h3RawFinLerayOuterProductDivergenceFourierL2
    exact MeasureTheory.MemLp.coeFn_toLp
      (h3RawFinLerayOuterProductDivergence_memLp2 U U j)
  change ((N - (2 : ℂ) • L : H3FourierComplexL2) :
    H3FourierPoint3 → ℂ) =ᵐ[_] _
  filter_upwards [MeasureTheory.Lp.coeFn_sub N ((2 : ℂ) • L),
    MeasureTheory.Lp.coeFn_smul (2 : ℂ) L,
    hLap, hN] with ξ hSub hSmul hLapξ hNξ
  rw [hSub]
  simp only [Pi.sub_apply]
  rw [hSmul]
  simp only [Pi.smul_apply, smul_eq_mul]
  rw [hLapξ, hNξ]
  ring

/-- Exact sharp Fourier annulus, not a substitute frequency window.
The nesting assumption is used only to simplify the indicator difference. -/
theorem thirdFullKinetic_sharpFourierAnnulusCutoff_ae244
    (rho sigma : ℝ) (hOrder : rho ≤ sigma)
    (F : H3FourierComplexL2) :
    ((h3CriticalFourierSharpLowCutoffCLM sigma F -
        h3CriticalFourierSharpLowCutoffCLM rho F :
        H3FourierComplexL2) : H3FourierPoint3 → ℂ)
      =ᵐ[(volume : Measure H3FourierPoint3)]
    (((h3TerminalRadialFrequencyBelow rho)ᶜ ∩
      h3TerminalRadialFrequencyBelow sigma).indicator F) := by
  change ((h3CriticalFourierSharpLowCutoffApply sigma F -
      h3CriticalFourierSharpLowCutoffApply rho F :
      H3FourierComplexL2) : H3FourierPoint3 → ℂ) =ᵐ[_] _
  filter_upwards [
    MeasureTheory.Lp.coeFn_sub
      (h3CriticalFourierSharpLowCutoffApply sigma F)
      (h3CriticalFourierSharpLowCutoffApply rho F),
    h3Critical_fourierSharpLowCutoffApply_ae sigma F,
    h3Critical_fourierSharpLowCutoffApply_ae rho F
  ] with ξ hSub hSigma hRho
  rw [hSub]
  simp only [Pi.sub_apply]
  rw [hSigma, hRho]
  by_cases hLow : ξ ∈ h3TerminalRadialFrequencyBelow rho
  · have hUpper : ξ ∈ h3TerminalRadialFrequencyBelow sigma := by
      change h3FourierGradientMagnitude ξ < rho at hLow
      change h3FourierGradientMagnitude ξ < sigma
      exact lt_of_lt_of_le hLow hOrder
    have hNot : ξ ∉ (h3TerminalRadialFrequencyBelow rho)ᶜ ∩
        h3TerminalRadialFrequencyBelow sigma := by
      intro hx
      exact hx.1 hLow
    rw [Set.indicator_of_mem hUpper,
      Set.indicator_of_mem hLow, Set.indicator_of_notMem hNot]
    simp
  · by_cases hUpper : ξ ∈ h3TerminalRadialFrequencyBelow sigma
    · have hIn : ξ ∈ (h3TerminalRadialFrequencyBelow rho)ᶜ ∩
          h3TerminalRadialFrequencyBelow sigma := ⟨hLow, hUpper⟩
      rw [Set.indicator_of_mem hUpper,
        Set.indicator_of_notMem hLow, Set.indicator_of_mem hIn]
      simp
    · have hNot : ξ ∉ (h3TerminalRadialFrequencyBelow rho)ᶜ ∩
          h3TerminalRadialFrequencyBelow sigma := by
        intro hx
        exact hUpper hx.2
      rw [Set.indicator_of_notMem hUpper,
        Set.indicator_of_notMem hLow, Set.indicator_of_notMem hNot]
      simp

/-- Plancherel identity for the exact bounded annulus, expressed entirely
through Fourier L² classes; no pointwise values are chosen. This is the same
indicator-pair reduction used by the compiled sharp highpass identity. -/
theorem thirdFullKinetic_sharpFourierAnnulusCutoff_norm_sq_eq_integral244
    (rho sigma : ℝ) (hOrder : rho ≤ sigma)
    (F : H3FourierComplexL2) :
    ‖h3CriticalFourierSharpLowCutoffCLM sigma F -
      h3CriticalFourierSharpLowCutoffCLM rho F‖ ^ 2 =
      ∫ ξ in ((h3TerminalRadialFrequencyBelow rho)ᶜ ∩
          h3TerminalRadialFrequencyBelow sigma),
        ‖(F : H3FourierPoint3 → ℂ) ξ‖ ^ 2 ∂volume := by
  have hS : MeasurableSet
      ((h3TerminalRadialFrequencyBelow rho)ᶜ ∩
        h3TerminalRadialFrequencyBelow sigma) :=
    (measurableSet_h3TerminalRadialFrequencyBelow rho).compl.inter
      (measurableSet_h3TerminalRadialFrequencyBelow sigma)
  rw [h3FourierComplexL2_norm_sq_eq_integral_norm_sq]
  rw [← integral_indicator hS]
  apply integral_congr_ae
  filter_upwards [thirdFullKinetic_sharpFourierAnnulusCutoff_ae244
    rho sigma hOrder F] with ξ hξ
  rw [hξ]
  by_cases hx : ξ ∈ (h3TerminalRadialFrequencyBelow rho)ᶜ ∩
      h3TerminalRadialFrequencyBelow sigma
  · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
  · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx]
    simp

/-- The unweighted nonlinear Young-gap integral on a fixed annulus is
continuous at every strict physical time. In particular NO assumption about
continuity of the raw quadratic Leray source is required. -/
theorem thirdFullPhysical_actualAnnularYoungResidualIntegral_continuousAt244
    {u : SpaceTimeVectorField ℝ ℝ MulReal Depth.three}
    {T : ℝ} (hH3 : LoggedPreterminalH3PathAdmissible u T)
    (rho sigma t : ℝ) (hOrder : rho ≤ sigma)
    (ht : t ∈ Set.Ioo (0 : ℝ) T) (j : Fin 3) :
    ContinuousAt (fun s : ℝ =>
      let U : H3SpectralVelocityState :=
        h3AuditActualSpectralVelocityTotal hH3 s
      ∫ ξ in ((h3TerminalRadialFrequencyBelow rho)ᶜ ∩
          h3TerminalRadialFrequencyBelow sigma),
        ‖h3RawFinLerayOuterProductDivergence U U j ξ +
          2 * ((h3FourierGradientSquare ξ : ℂ) *
            h3SpectralScalarRawFourierL2 (U j) ξ)‖ ^ 2 ∂volume) t := by
  let S : Set H3FourierPoint3 :=
    (h3TerminalRadialFrequencyBelow rho)ᶜ ∩
      h3TerminalRadialFrequencyBelow sigma
  have hEq (s : ℝ) :
      (∫ ξ in S,
        ‖h3RawFinLerayOuterProductDivergence
            (h3AuditActualSpectralVelocityTotal hH3 s)
            (h3AuditActualSpectralVelocityTotal hH3 s) j ξ +
          2 * ((h3FourierGradientSquare ξ : ℂ) *
            h3SpectralScalarRawFourierL2
              ((h3AuditActualSpectralVelocityTotal hH3 s) j) ξ)‖ ^ 2
          ∂volume) =
        ‖thirdFullPhysicalAnnularYoungResidualBandFourierL2244
          rho sigma (h3AuditActualSpectralVelocityTotal hH3 s) j‖ ^ 2 := by
    let U : H3SpectralVelocityState :=
      h3AuditActualSpectralVelocityTotal hH3 s
    let G : H3FourierComplexL2 :=
      thirdFullPhysicalAnnularYoungResidualFourierL2244 U j
    have hIntegral :
        (∫ ξ in S,
          ‖(G : H3FourierPoint3 → ℂ) ξ‖ ^ 2 ∂volume) =
        (∫ ξ in S,
          ‖h3RawFinLerayOuterProductDivergence U U j ξ +
            2 * ((h3FourierGradientSquare ξ : ℂ) *
              h3SpectralScalarRawFourierL2 (U j) ξ)‖ ^ 2 ∂volume) := by
      apply integral_congr_ae
      filter_upwards [ae_restrict_of_ae (s := S)
        (thirdFullPhysical_annularYoungResidualFourier_ae244 U j)]
        with ξ hξ
      rw [hξ]
    have hCut := thirdFullKinetic_sharpFourierAnnulusCutoff_norm_sq_eq_integral244
      rho sigma hOrder G
    change ‖thirdFullPhysicalAnnularYoungResidualBandFourierL2244 rho sigma U j‖ ^ 2 =
      ∫ ξ in S, ‖(G : H3FourierPoint3 → ℂ) ξ‖ ^ 2 at hCut
    change (∫ ξ in S,
      ‖h3RawFinLerayOuterProductDivergence U U j ξ +
        2 * ((h3FourierGradientSquare ξ : ℂ) *
          h3SpectralScalarRawFourierL2 (U j) ξ)‖ ^ 2 ∂volume) = _
    exact hIntegral.symm.trans hCut.symm
  change ContinuousAt (fun s : ℝ =>
    ∫ ξ in S,
      ‖h3RawFinLerayOuterProductDivergence
          (h3AuditActualSpectralVelocityTotal hH3 s)
          (h3AuditActualSpectralVelocityTotal hH3 s) j ξ +
        2 * ((h3FourierGradientSquare ξ : ℂ) *
          h3SpectralScalarRawFourierL2
            ((h3AuditActualSpectralVelocityTotal hH3 s) j) ξ)‖ ^ 2
      ∂volume) t
  have hFun : (fun s : ℝ =>
      ∫ ξ in S,
        ‖h3RawFinLerayOuterProductDivergence
            (h3AuditActualSpectralVelocityTotal hH3 s)
            (h3AuditActualSpectralVelocityTotal hH3 s) j ξ +
          2 * ((h3FourierGradientSquare ξ : ℂ) *
            h3SpectralScalarRawFourierL2
              ((h3AuditActualSpectralVelocityTotal hH3 s) j) ξ)‖ ^ 2
        ∂volume) =
      (fun s : ℝ =>
        ‖thirdFullPhysicalAnnularYoungResidualBandFourierL2244
          rho sigma (h3AuditActualSpectralVelocityTotal hH3 s) j‖ ^ 2) := by
    funext s
    exact hEq s
  rw [hFun]
  exact thirdFullPhysical_actualAnnularYoungResidualBandSquare_continuousAt244
    hH3 rho sigma t ht j

end
end PrimeTensor.FirstMonomialTriad
