/-- The `01` curl-test velocity pairing is exactly the old z-vorticity weak
pairing. -/
theorem h3PreterminalTailCanonicalVelocityWeakPairingOnElapsed_curl01_eq_weakVorticityZ
    {E : ℝ}
    {u : SpaceTimeVectorField ℝ ℝ MulReal Depth.three}
    {T t tau : ℝ}
    (hNS : LoggedPreterminalNavierStokesAdmissible u T)
    (ht : t ∈ Set.Ioo (0 : ℝ) T)
    (hEnd : t + tau < T)
    (hTail : CanonicalH3TailDataFrom u t T E)
    (ψ : H3WeakTestFunction)
    (q : Set.Icc (0 : ℝ) tau) :
    h3PreterminalTailCanonicalVelocityWeakPairingOnElapsed
        hNS ht hEnd hTail (h3WeakTestCurl01 ψ) q
      =
    h3PreterminalTailCanonicalWeakVorticityZPairingOnElapsed
      (u := u) (t := t) ψ q := by
  have h0 :=
    inner_h3WeakTestFunctionSpatialDerivative_preterminalSlot0_eq_neg_pairing_loggedVelocitySpatialDerivative
      hNS ht hEnd hTail q (0 : Fin 3) yAxis ψ

  have h1 :=
    inner_h3WeakTestFunctionSpatialDerivative_preterminalSlot0_eq_neg_pairing_loggedVelocitySpatialDerivative
      hNS ht hEnd hTail q (1 : Fin 3) xAxis ψ

  simp only [h3AxisOfFin3_zero] at h0
  simp only [h3AxisOfFin3_one] at h1

  have hDx :
      Integrable
        (fun x : Point3 =>
          (ContinuousLinearMap.lsmul ℝ ℝ)
            (ψ x)
            (spatial3.d
              xAxis
              (loggedVelocityComponent u (t + (q : ℝ)) yAxis)
              x))
        (volume : Measure Point3) :=
    h3PreterminalTailCanonical_test_mul_loggedVelocitySpatialDerivative_integrable
      hNS ht hEnd hTail q yAxis xAxis ψ

  have hDy :
      Integrable
        (fun x : Point3 =>
          (ContinuousLinearMap.lsmul ℝ ℝ)
            (ψ x)
            (spatial3.d
              yAxis
              (loggedVelocityComponent u (t + (q : ℝ)) xAxis)
              x))
        (volume : Measure Point3) :=
    h3PreterminalTailCanonical_test_mul_loggedVelocitySpatialDerivative_integrable
      hNS ht hEnd hTail q xAxis yAxis ψ

  have hVorticityPointwise
      (x : Point3) :
      realVorticityZ
          (logSpaceTimeVectorField u)
          (t + (q : ℝ))
          x
        =
      spatial3.d
          xAxis
          (loggedVelocityComponent u (t + (q : ℝ)) yAxis)
          x
        -
      spatial3.d
          yAxis
          (loggedVelocityComponent u (t + (q : ℝ)) xAxis)
          x := by
    rfl

  have hVort :
      h3PreterminalTailCanonicalWeakVorticityZPairingOnElapsed
          (u := u) (t := t) ψ q
        =
      (∫ x : Point3,
        (ContinuousLinearMap.lsmul ℝ ℝ)
          (ψ x)
          (spatial3.d
            xAxis
            (loggedVelocityComponent u (t + (q : ℝ)) yAxis)
            x)
        ∂volume)
        -
      (∫ x : Point3,
        (ContinuousLinearMap.lsmul ℝ ℝ)
          (ψ x)
          (spatial3.d
            yAxis
            (loggedVelocityComponent u (t + (q : ℝ)) xAxis)
            x)
        ∂volume) := by
    unfold h3PreterminalTailCanonicalWeakVorticityZPairingOnElapsed
    rw [← integral_sub hDx hDy]
    apply integral_congr_ae
    filter_upwards with x
    rw [hVorticityPointwise x]
    exact
      ((ContinuousLinearMap.lsmul ℝ ℝ) (ψ x)).map_sub
        (spatial3.d
          xAxis
          (loggedVelocityComponent u (t + (q : ℝ)) yAxis)
          x)
        (spatial3.d
          yAxis
          (loggedVelocityComponent u (t + (q : ℝ)) xAxis)
          x)

  unfold h3PreterminalTailCanonicalVelocityWeakPairingOnElapsed
  rw [Fin.sum_univ_three]
  simp only [
    h3WeakTestCurl01_apply_zero,
    h3WeakTestCurl01_apply_one,
    h3WeakTestCurl01_apply_two,
    h3WeakTestFunctionPhysicalL2_neg,
    h3WeakTestFunctionPhysicalL2_zero
  ]
  simp
  rw [h0, h1, hVort]
  ring

/-- The `02` curl-test velocity pairing is minus the old y-vorticity weak
pairing. -/
theorem h3PreterminalTailCanonicalVelocityWeakPairingOnElapsed_curl02_eq_neg_weakVorticityY
    {E : ℝ}
    {u : SpaceTimeVectorField ℝ ℝ MulReal Depth.three}
    {T t tau : ℝ}
    (hNS : LoggedPreterminalNavierStokesAdmissible u T)
    (ht : t ∈ Set.Ioo (0 : ℝ) T)
    (hEnd : t + tau < T)
    (hTail : CanonicalH3TailDataFrom u t T E)
    (ψ : H3WeakTestFunction)
    (q : Set.Icc (0 : ℝ) tau) :
    h3PreterminalTailCanonicalVelocityWeakPairingOnElapsed
        hNS ht hEnd hTail (h3WeakTestCurl02 ψ) q
      =
    -
    h3PreterminalTailCanonicalWeakVorticityYPairingOnElapsed
      (u := u) (t := t) ψ q := by
  have h0 :=
    inner_h3WeakTestFunctionSpatialDerivative_preterminalSlot0_eq_neg_pairing_loggedVelocitySpatialDerivative
      hNS ht hEnd hTail q (0 : Fin 3) zAxis ψ

  have h2 :=
    inner_h3WeakTestFunctionSpatialDerivative_preterminalSlot0_eq_neg_pairing_loggedVelocitySpatialDerivative
      hNS ht hEnd hTail q (2 : Fin 3) xAxis ψ

  simp only [h3AxisOfFin3_zero] at h0
  simp only [h3AxisOfFin3_two] at h2

  have hDz :
      Integrable
        (fun x : Point3 =>
          (ContinuousLinearMap.lsmul ℝ ℝ)
            (ψ x)
            (spatial3.d
              zAxis
              (loggedVelocityComponent u (t + (q : ℝ)) xAxis)
              x))
        (volume : Measure Point3) :=
    h3PreterminalTailCanonical_test_mul_loggedVelocitySpatialDerivative_integrable
      hNS ht hEnd hTail q xAxis zAxis ψ

  have hDx :
      Integrable
        (fun x : Point3 =>
          (ContinuousLinearMap.lsmul ℝ ℝ)
            (ψ x)
            (spatial3.d
              xAxis
              (loggedVelocityComponent u (t + (q : ℝ)) zAxis)
              x))
        (volume : Measure Point3) :=
    h3PreterminalTailCanonical_test_mul_loggedVelocitySpatialDerivative_integrable
      hNS ht hEnd hTail q zAxis xAxis ψ

  have hVorticityPointwise
      (x : Point3) :
      realVorticityY
          (logSpaceTimeVectorField u)
          (t + (q : ℝ))
          x
        =
      spatial3.d
          zAxis
          (loggedVelocityComponent u (t + (q : ℝ)) xAxis)
          x
        -
      spatial3.d
          xAxis
          (loggedVelocityComponent u (t + (q : ℝ)) zAxis)
          x := by
    rfl

  have hVort :
      h3PreterminalTailCanonicalWeakVorticityYPairingOnElapsed
          (u := u) (t := t) ψ q
        =
      (∫ x : Point3,
        (ContinuousLinearMap.lsmul ℝ ℝ)
          (ψ x)
          (spatial3.d
            zAxis
            (loggedVelocityComponent u (t + (q : ℝ)) xAxis)
            x)
        ∂volume)
        -
      (∫ x : Point3,
        (ContinuousLinearMap.lsmul ℝ ℝ)
          (ψ x)
          (spatial3.d
            xAxis
            (loggedVelocityComponent u (t + (q : ℝ)) zAxis)
            x)
        ∂volume) := by
    unfold h3PreterminalTailCanonicalWeakVorticityYPairingOnElapsed
    rw [← integral_sub hDz hDx]
    apply integral_congr_ae
    filter_upwards with x
    rw [hVorticityPointwise x]
    exact
      ((ContinuousLinearMap.lsmul ℝ ℝ) (ψ x)).map_sub
        (spatial3.d
          zAxis
          (loggedVelocityComponent u (t + (q : ℝ)) xAxis)
          x)
        (spatial3.d
          xAxis
          (loggedVelocityComponent u (t + (q : ℝ)) zAxis)
          x)

  unfold h3PreterminalTailCanonicalVelocityWeakPairingOnElapsed
  rw [Fin.sum_univ_three]
  simp only [
    h3WeakTestCurl02_apply_zero,
    h3WeakTestCurl02_apply_one,
    h3WeakTestCurl02_apply_two,
    h3WeakTestFunctionPhysicalL2_neg,
    h3WeakTestFunctionPhysicalL2_zero
  ]
  simp
  rw [h0, h2, hVort]
  ring

/-- The `12` curl-test velocity pairing is exactly the old x-vorticity weak
pairing. -/
theorem h3PreterminalTailCanonicalVelocityWeakPairingOnElapsed_curl12_eq_weakVorticityX
    {E : ℝ}
    {u : SpaceTimeVectorField ℝ ℝ MulReal Depth.three}
    {T t tau : ℝ}
    (hNS : LoggedPreterminalNavierStokesAdmissible u T)
    (ht : t ∈ Set.Ioo (0 : ℝ) T)
    (hEnd : t + tau < T)
    (hTail : CanonicalH3TailDataFrom u t T E)
    (ψ : H3WeakTestFunction)
    (q : Set.Icc (0 : ℝ) tau) :
    h3PreterminalTailCanonicalVelocityWeakPairingOnElapsed
        hNS ht hEnd hTail (h3WeakTestCurl12 ψ) q
      =
    h3PreterminalTailCanonicalWeakVorticityXPairingOnElapsed
      (u := u) (t := t) ψ q := by
  have h1 :=
    inner_h3WeakTestFunctionSpatialDerivative_preterminalSlot0_eq_neg_pairing_loggedVelocitySpatialDerivative
      hNS ht hEnd hTail q (1 : Fin 3) zAxis ψ

  have h2 :=
    inner_h3WeakTestFunctionSpatialDerivative_preterminalSlot0_eq_neg_pairing_loggedVelocitySpatialDerivative
      hNS ht hEnd hTail q (2 : Fin 3) yAxis ψ

  simp only [h3AxisOfFin3_one] at h1
  simp only [h3AxisOfFin3_two] at h2

  have hDy :
      Integrable
        (fun x : Point3 =>
          (ContinuousLinearMap.lsmul ℝ ℝ)
            (ψ x)
            (spatial3.d
              yAxis
              (loggedVelocityComponent u (t + (q : ℝ)) zAxis)
              x))
        (volume : Measure Point3) :=
    h3PreterminalTailCanonical_test_mul_loggedVelocitySpatialDerivative_integrable
      hNS ht hEnd hTail q zAxis yAxis ψ

  have hDz :
      Integrable
        (fun x : Point3 =>
          (ContinuousLinearMap.lsmul ℝ ℝ)
            (ψ x)
            (spatial3.d
              zAxis
              (loggedVelocityComponent u (t + (q : ℝ)) yAxis)
              x))
        (volume : Measure Point3) :=
    h3PreterminalTailCanonical_test_mul_loggedVelocitySpatialDerivative_integrable
      hNS ht hEnd hTail q yAxis zAxis ψ

  have hVorticityPointwise
      (x : Point3) :
      realVorticityX
          (logSpaceTimeVectorField u)
          (t + (q : ℝ))
          x
        =
      spatial3.d
          yAxis
          (loggedVelocityComponent u (t + (q : ℝ)) zAxis)
          x
        -
      spatial3.d
          zAxis
          (loggedVelocityComponent u (t + (q : ℝ)) yAxis)
          x := by
    rfl

  have hVort :
      h3PreterminalTailCanonicalWeakVorticityXPairingOnElapsed
          (u := u) (t := t) ψ q
        =
      (∫ x : Point3,
        (ContinuousLinearMap.lsmul ℝ ℝ)
          (ψ x)
          (spatial3.d
            yAxis
            (loggedVelocityComponent u (t + (q : ℝ)) zAxis)
            x)
        ∂volume)
        -
      (∫ x : Point3,
        (ContinuousLinearMap.lsmul ℝ ℝ)
          (ψ x)
          (spatial3.d
            zAxis
            (loggedVelocityComponent u (t + (q : ℝ)) yAxis)
            x)
        ∂volume) := by
    unfold h3PreterminalTailCanonicalWeakVorticityXPairingOnElapsed
    rw [← integral_sub hDy hDz]
    apply integral_congr_ae
    filter_upwards with x
    rw [hVorticityPointwise x]
    exact
      ((ContinuousLinearMap.lsmul ℝ ℝ) (ψ x)).map_sub
        (spatial3.d
          yAxis
          (loggedVelocityComponent u (t + (q : ℝ)) zAxis)
          x)
        (spatial3.d
          zAxis
          (loggedVelocityComponent u (t + (q : ℝ)) yAxis)
          x)

  unfold h3PreterminalTailCanonicalVelocityWeakPairingOnElapsed
  rw [Fin.sum_univ_three]
  simp only [
    h3WeakTestCurl12_apply_zero,
    h3WeakTestCurl12_apply_one,
    h3WeakTestCurl12_apply_two,
    h3WeakTestFunctionPhysicalL2_neg,
    h3WeakTestFunctionPhysicalL2_zero
  ]
  simp
  rw [h1, h2, hVort]
  ring

end

